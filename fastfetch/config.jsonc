// Liquid Lambda fastfetch config, COSMIC logo.
// Generated by `uv run lambda build` from templates/fastfetch/config.jsonc.j2. Do not edit.
// `lambda apply --only fastfetch` links it and fastfetch/cosmic.txt into ~/.config/fastfetch/.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/cosmic.txt",
    "color": {
      "1": "38;2;0;223;254"
    },
    "padding": {
      "top": 3,
      "left": 2,
      "right": 6
    }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;71;61;60m┌───────────────────────\u001b[38;2;209;149;85mHardware\u001b[38;2;71;61;60m───────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "cpu",
      "key": "├ ",
      "keyColor": "38;2;132;164;171",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "├ 󰢮",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "display",
      "key": "├ 󰍹",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "disk",
      "key": "├ ",
      "keyColor": "38;2;132;164;171",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": "├ 󰍛",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "swap",
      "key": "├ 󰓡",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "battery",
      "key": "└ 󰁹",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;71;61;60m└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;71;61;60m┌───────────────────────\u001b[38;2;209;149;85mSoftware\u001b[38;2;71;61;60m───────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "38;2;132;164;171",
      "format": "{name} {version-id}"
    },
    {
      "type": "de",
      "key": "├ ",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "wm",
      "key": "├ ",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "kernel",
      "key": "├ ",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "shell",
      "key": "├ ",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "terminal",
      "key": "├ ",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "packages",
      "key": "├ 󰏖",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "command",
      "key": "├ 󰏘",
      "keyColor": "38;2;132;164;171",
      "text": "echo -n 'Lambda '; for c in 228,224,223 0,223,254 153,238,255 136,202,149 209,149,85 239,102,97 146,138,137; do printf '\\033[38;2;%sm●' \"$(echo $c | tr , \\;)\"; done"
    },
    {
      "type": "terminalfont",
      "key": "└ ",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;71;61;60m└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;71;61;60m┌────────────────\u001b[38;2;209;149;85mAge / Uptime / Update\u001b[38;2;71;61;60m─────────────────┐"
    },
    {
      "type": "command",
      "key": "󰔟 OS Age",
      "keyColor": "38;2;132;164;171",
      "text": "b=$(stat -c %W / 2>/dev/null); [ \"${b:-0}\" -le 0 ] && b=$(stat -c %Y /var/log/installer 2>/dev/null); echo \"$(( ($(date +%s) - b) / 86400 )) days\""
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "38;2;132;164;171"
    },
    {
      "type": "command",
      "key": "󰚰 Update",
      "keyColor": "38;2;132;164;171",
      "text": "d=$( { zcat -f /var/log/apt/history.log* 2>/dev/null; } | grep '^Start-Date' | sort | tail -1 | cut -d' ' -f2- ); [ -n \"$d\" ] && date -d \"$d\" '+%A, %B %d %Y at %H:%M' || echo unknown"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;71;61;60m└──────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
