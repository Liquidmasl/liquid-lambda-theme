# Liquid Lambda colour scheme for WezTerm.
# Generated by `uv run lambda build` from templates/wezterm/Lambda.toml.j2. Do not edit.
# `lambda apply --only wezterm` links it into ~/.config/wezterm/colors/;
# select it with  config.color_scheme = 'Lambda'

[colors]
foreground = '{{ text }}'
background = '{{ bg }}'
cursor_bg = '{{ lead }}'
cursor_border = '{{ lead }}'
cursor_fg = '{{ lead_ink }}'
compose_cursor = '{{ second }}'
selection_bg = '{{ lead.mix(bg, 0.7) }}'
selection_fg = '{{ text }}'
scrollbar_thumb = '{{ surface3 }}'
split = '{{ lead.mix(bg, 0.35) }}'
visual_bell = '{{ err.mix(bg, 0.8) }}'
ansi = [{% for c in ansi[:8] %}'{{ c }}'{{ ", " if not loop.last }}{% endfor %}]
brights = [{% for c in ansi[8:] %}'{{ c }}'{{ ", " if not loop.last }}{% endfor %}]

[colors.tab_bar]
background = '{{ bg }}'
inactive_tab_edge = '{{ line }}'

[colors.tab_bar.active_tab]
bg_color = '{{ surface2 }}'
fg_color = '{{ text }}'

[colors.tab_bar.inactive_tab]
bg_color = '{{ bg }}'
fg_color = '{{ muted }}'

[colors.tab_bar.inactive_tab_hover]
bg_color = '{{ surface1 }}'
fg_color = '{{ sub }}'

[colors.tab_bar.new_tab]
bg_color = '{{ bg }}'
fg_color = '{{ muted }}'

[colors.tab_bar.new_tab_hover]
bg_color = '{{ surface1 }}'
fg_color = '{{ lead }}'

[metadata]
name = 'Lambda'
origin_url = 'https://github.com/Liquidmasl/liquid-lambda-theme'
