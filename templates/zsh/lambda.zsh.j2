# Liquid Lambda colours for zsh: file colours (ls, lsd, completion) and the
# zsh-autosuggestions / zsh-syntax-highlighting styles.
# Generated by `uv run lambda build` from templates/zsh/lambda.zsh.j2. Do not edit.
# `lambda apply --only zsh` sources it from ~/.zshrc.local (or ~/.zshrc).

# ── File colours ───────────────────────────────────────────────────────────────
{%- set code = "rs py js ts tsx vue go c h cpp lua sh zsh toml yaml yml json".split() %}
{%- set docs = "md txt rst pdf".split() %}
{%- set media = "png jpg jpeg webp gif svg avif mp4 mkv webm mov".split() %}
{%- set archives = "zip tar gz xz zst 7z deb rpm".split() %}
{%- set parts = [
  "di=1;" ~ blue.ansi_fg,
  "ln=3;" ~ cyan.ansi_fg,
  "ex=1;" ~ ok.ansi_fg,
  "or=9;" ~ err.ansi_fg,
  "mi=9;" ~ err.ansi_fg,
] %}
{%- for e in code %}{% set _ = parts.append("*." ~ e ~ "=" ~ sub.ansi_fg) %}{% endfor %}
{%- for e in docs %}{% set _ = parts.append("*." ~ e ~ "=" ~ muted.ansi_fg) %}{% endfor %}
{%- for e in media %}{% set _ = parts.append("*." ~ e ~ "=" ~ magenta.ansi_fg) %}{% endfor %}
{%- for e in archives %}{% set _ = parts.append("*." ~ e ~ "=4;" ~ second.ansi_fg) %}{% endfor %}

export LS_COLORS="{{ parts | join(':') }}"

# completion menus read LS_COLORS when they are set up, so refresh them
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# ── zsh-autosuggestions / zsh-syntax-highlighting ──────────────────────────────

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg={{ dim.mix(bg, 0.25) }}'

typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg={{ lead }}'
ZSH_HIGHLIGHT_STYLES[builtin]='fg={{ lead }}'
ZSH_HIGHLIGHT_STYLES[alias]='fg={{ lead }}'
ZSH_HIGHLIGHT_STYLES[function]='fg={{ lead }}'
ZSH_HIGHLIGHT_STYLES[hashed-command]='fg={{ lead }}'
ZSH_HIGHLIGHT_STYLES[suffix-alias]='fg={{ lead }},underline'
ZSH_HIGHLIGHT_STYLES[precommand]='fg={{ ok }},underline'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg={{ blue }},bold'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg={{ err }},bold,underline'
ZSH_HIGHLIGHT_STYLES[path]='fg={{ sub }},underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg={{ second }}'
ZSH_HIGHLIGHT_STYLES[history-expansion]='fg={{ second }}'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg={{ muted }}'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg={{ muted }}'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg={{ ok }}'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg={{ ok }}'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg={{ ok }}'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg={{ muted }}'
ZSH_HIGHLIGHT_STYLES[redirection]='fg={{ muted }}'
ZSH_HIGHLIGHT_STYLES[comment]='fg={{ dim }}'
