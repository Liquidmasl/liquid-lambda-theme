# Liquid Lambda theme for btop.
# Generated by `uv run lambda build` from templates/btop/Lambda.theme.j2. Do not edit.
# `lambda apply --only btop` links it into ~/.config/btop/themes/ and selects it.

# Main background, empty for terminal default (needed for a transparent terminal)
theme[main_bg]="{{ bg }}"
theme[main_fg]="{{ sub }}"
theme[title]="{{ lead }}"
# keyboard shortcuts
theme[hi_fg]="{{ second }}"
theme[selected_bg]="{{ lead }}"
theme[selected_fg]="{{ lead_ink }}"
theme[inactive_fg]="{{ line }}"
theme[graph_text]="{{ muted }}"
theme[meter_bg]="{{ surface2 }}"
theme[proc_misc]="{{ text }}"

theme[cpu_box]="{{ line }}"
theme[mem_box]="{{ line }}"
theme[net_box]="{{ line }}"
theme[proc_box]="{{ line }}"
theme[div_line]="{{ surface3 }}"

# Meters and graphs run cool to hot: cyan rim -> amber core -> error red
{%- for meter in ["temp", "cpu", "free", "download", "upload"] %}
theme[{{ meter }}_start]="{{ lead }}"
theme[{{ meter }}_mid]="{{ second }}"
theme[{{ meter }}_end]="{{ err }}"
{%- endfor %}

theme[cached_start]="{{ blue }}"
theme[cached_mid]="{{ blue }}"
theme[cached_end]="{{ blue }}"

theme[available_start]="{{ ok }}"
theme[available_mid]="{{ ok }}"
theme[available_end]="{{ ok }}"

theme[used_start]="{{ second }}"
theme[used_mid]="{{ second }}"
theme[used_end]="{{ err }}"

theme[process_start]="{{ lead }}"
theme[process_mid]="{{ second }}"
theme[process_end]="{{ err }}"
