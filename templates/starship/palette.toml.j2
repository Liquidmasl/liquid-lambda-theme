# Liquid Lambda palette for Starship.
# Generated by `uv run lambda build` from templates/starship/palette.toml.j2. Do not edit.
# `lambda apply --only starship` puts this table into ~/.config/starship.toml
# with `palette = "lambda"` at the top. The standard names are overridden, so
# styles like "bold cyan" come out in the palette in any terminal.
[palettes.lambda]
black = "{{ ansi[0] }}"
red = "{{ ansi[1] }}"
green = "{{ ansi[2] }}"
yellow = "{{ ansi[3] }}"
blue = "{{ ansi[4] }}"
purple = "{{ ansi[5] }}"
cyan = "{{ ansi[6] }}"
white = "{{ ansi[7] }}"
bright-black = "{{ ansi[8] }}"
bright-red = "{{ ansi[9] }}"
bright-green = "{{ ansi[10] }}"
bright-yellow = "{{ ansi[11] }}"
bright-blue = "{{ ansi[12] }}"
bright-purple = "{{ ansi[13] }}"
bright-cyan = "{{ ansi[14] }}"
bright-white = "{{ ansi[15] }}"
lead = "{{ lead }}"
second = "{{ second }}"
text = "{{ text }}"
sub = "{{ sub }}"
muted = "{{ muted }}"
dim = "{{ dim }}"
surface = "{{ surface2 }}"
ok = "{{ ok }}"
warn = "{{ warn }}"
err = "{{ err }}"
