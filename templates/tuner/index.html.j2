<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Generated by `uv run lambda build` from templates/tuner/index.html.j2. Do not edit. -->
<title>Lambda Palette Tuner</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&family=Chivo:wght@300;400;600&display=swap">
<style>
/* Control strip, a mock desktop, a browser strip and the palette sheet. The page is
   painted by the palette it shows; the values below are palette.toml as built. */
:root {
  color-scheme: dark;
  --bg:{{ bg }}; --s1:{{ surface1 }}; --s2:{{ surface2 }}; --s3:{{ surface3 }}; --line:{{ line }};
  --dim:{{ dim }}; --muted:{{ muted }}; --sub:{{ sub }}; --text:{{ text }};
  --lead:{{ lead }}; --lead-ink:{{ lead_ink }}; --second:{{ second }}; --second-ink:{{ second_ink }};
  --cyan:{{ cyan }}; --amber:{{ amber }};
  --ok:{{ ok }}; --warn:{{ warn }}; --err:{{ err }}; --link:{{ link }}; --hint:{{ hint }};
{% for c in ansi %}  --a{{ loop.index0 }}:{{ c }};
{% endfor %}  --mono: "Maple Mono NFM", "Maple Mono", "JetBrains Mono", ui-monospace, monospace;
  --ui: "Maple Mono Normal", "JetBrains Mono", ui-monospace, monospace;
  --page: "Chivo", system-ui, sans-serif;
}
* { box-sizing: border-box }
html { background: var(--bg) }
body {
  margin: 0; background: var(--bg); color: var(--text); font-family: var(--page); font-size: 15px;
  padding: 20px max(16px, env(safe-area-inset-right, 0px)) 48px max(16px, env(safe-area-inset-left, 0px));
}
.wrap { max-width: 1400px; margin: 0 auto; display: grid; gap: 20px }
h1 { font-family: var(--mono); font-weight: 500; font-size: 1.35rem; margin: 0; letter-spacing: .02em; text-wrap: balance }
h1 b { color: var(--cyan); font-weight: 700 }
h1 i { color: var(--amber); font-style: normal }
.lede { color: var(--muted); margin: 4px 0 0; max-width: 72ch; line-height: 1.5 }
.lede code { font-family: var(--mono); color: var(--sub) }
h2 { font-family: var(--mono); font-size: .78rem; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); font-weight: 500; margin: 0 0 10px }

.controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px 22px;
  background: var(--s1); border: 1px solid var(--line); border-radius: 6px; padding: 14px 16px }
.ctl { display: grid; gap: 6px; min-width: 0 }
.ctl label, .ctl .lbl { font-family: var(--mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted) }
.ctl label span { color: var(--sub); text-transform: none; letter-spacing: 0 }
.seg { display: flex; border: 1px solid var(--line); border-radius: 4px; overflow: hidden }
.seg button { flex: 1; background: transparent; color: var(--sub); border: 0; padding: 7px 6px; font: 500 .82rem var(--mono); cursor: pointer }
.seg button + button { border-left: 1px solid var(--line) }
.seg button[aria-pressed="true"] { background: var(--lead); color: var(--lead-ink) }
.seg button:focus-visible, .btn:focus-visible, input[type=range]:focus-visible { outline: 2px solid var(--hint); outline-offset: 2px }
input[type=range] { width: 100%; accent-color: var(--lead) }
.ctl.actions { align-content: end; grid-auto-flow: column; justify-content: start; gap: 8px }
.btn { background: var(--s2); color: var(--text); border: 1px solid var(--line); border-radius: 4px; padding: 7px 12px; font: 500 .82rem var(--mono); cursor: pointer }
.btn.primary { background: var(--lead); color: var(--lead-ink); border-color: transparent }
.toast { font-family: var(--mono); font-size: .78rem; color: var(--ok); align-self: center }

/* desktop: the wallpaper given to `lambda preview`, or a glow in the two accents */
.desk { position: relative; border-radius: 6px; overflow: hidden; border: 1px solid var(--line);
  display: grid; grid-template-rows: auto 1fr auto; min-height: 640px;
{% if wallpaper %}  background: #000 url({{ wallpaper }}) 78% 50% / cover no-repeat;
{% else %}  background:
    radial-gradient(ellipse 22% 34% at 62% 52%, color-mix(in oklab, var(--amber) 70%, transparent), transparent 70%),
    radial-gradient(ellipse 30% 44% at 62% 52%, color-mix(in oklab, var(--cyan) 28%, transparent), transparent 72%),
    repeating-linear-gradient(135deg, transparent 0 46px, color-mix(in oklab, var(--amber) 10%, transparent) 46px 47px),
    var(--bg);
{% endif %}}
.panel { display: flex; align-items: center; gap: 14px; padding: 5px 12px; font: 300 .8rem var(--ui); color: var(--text);
  background: color-mix(in oklab, var(--s1) 72%, transparent); backdrop-filter: blur(14px) }
.ws { display: flex; gap: 4px }
.ws span { width: 22px; height: 18px; display: grid; place-items: center; border-radius: 3px; color: var(--muted); font-size: .72rem }
.ws span.on { background: var(--lead); color: var(--lead-ink); font-weight: 500 }
.panel .grow { flex: 1 }
.panel .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--second); display: inline-block; margin-right: 6px }
.stage { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .7fr) minmax(0, 1fr); gap: 16px; padding: 18px; align-items: start }
.win { background: color-mix(in oklab, var(--bg) 84%, transparent); backdrop-filter: blur(18px) saturate(1.1);
  border-radius: 4px; border: 1px solid var(--line); overflow: hidden; min-width: 0 }
.win.active { border-color: var(--hint); box-shadow: 0 0 0 1px var(--hint) }
.win .bar { display: flex; align-items: center; gap: 8px; padding: 6px 10px; font: 300 .78rem var(--ui); color: var(--muted);
  background: color-mix(in oklab, var(--s1) 80%, transparent) }
.win.active .bar { color: var(--text) }
.win .bar .x { margin-left: auto; width: 10px; height: 10px; border-radius: 50%; background: var(--line) }
.term-col { grid-column: 1 }
.set-col { grid-column: 3 }

.term { font: 400 .78rem/1.35 var(--mono); padding: 10px 12px 0; color: var(--a15); white-space: pre; overflow-x: auto }
.term .sl { margin: 8px -12px 0; padding: 4px 12px; border-top: 1px solid var(--line); background: color-mix(in oklab, var(--bg) 60%, transparent) }
{% for i in range(16) %}.f{{ i }}{color:var(--a{{ i }})}
{% endfor %}.b{font-weight:700}.dimt{opacity:.55}
.pz-h{color:var(--lead);font-weight:700}.pz-b{color:var(--second)}.pz-c{color:var(--ok)}.pz-p{color:var(--cyan)}
.pz-n{color:var(--a5)}.pz-s{color:var(--text);font-weight:700}.pz-r{color:var(--dim)}.pz-th{color:var(--lead);font-weight:700}.pz-l{color:var(--link);text-decoration:underline}

.set { display: grid; grid-template-columns: 120px minmax(0,1fr); font: 300 .8rem var(--ui); min-height: 420px }
.side { background: color-mix(in oklab, var(--s1) 70%, transparent); padding: 8px 6px; display: grid; gap: 2px; align-content: start }
.side div { padding: 6px 8px; border-radius: 4px; color: var(--sub) }
.side div.sel { background: color-mix(in oklab, var(--lead) 18%, transparent); color: var(--lead); font-weight: 500 }
.main { padding: 12px 14px; display: grid; gap: 12px; align-content: start; min-width: 0 }
.main h3 { margin: 0; font: 500 .95rem var(--ui) }
.row { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 8px 10px; background: color-mix(in oklab, var(--s2) 70%, transparent); border-radius: 4px }
.tog { width: 32px; height: 18px; border-radius: 9px; background: var(--line); position: relative; flex: none }
.tog::after { content: ""; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: var(--sub) }
.tog.on { background: var(--lead) } .tog.on::after { left: 16px; background: var(--lead-ink) }
.slide { height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--lead) 62%, var(--line) 62%); position: relative }
.slide::after { content: ""; position: absolute; left: 62%; top: -5px; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: var(--lead) }
.field { border: 1px solid var(--hint); box-shadow: 0 0 0 2px color-mix(in oklab, var(--hint) 30%, transparent); background: var(--bg); padding: 6px 8px; border-radius: 4px; color: var(--text) }
.field i { display: inline-block; width: 1px; height: 1em; background: var(--lead); vertical-align: -2px; margin-left: 1px }
.banner { border-left: 3px solid var(--warn); background: color-mix(in oklab, var(--warn) 12%, transparent); padding: 7px 10px; border-radius: 0 4px 4px 0; color: var(--text) }
.banner b { color: var(--warn); font-weight: 500 }
.btns { display: flex; gap: 8px; flex-wrap: wrap }
.mb { padding: 6px 12px; border-radius: 4px; font: 500 .78rem var(--ui); border: 0 }
.mb.p { background: var(--lead); color: var(--lead-ink) }
.mb.s { background: var(--s3); color: var(--text) }
.mb.d { background: var(--err); color: var(--bg) }
.ln { color: var(--link) }
.chips { display: flex; gap: 6px; flex-wrap: wrap }
.chip { padding: 2px 8px; border-radius: 10px; font-size: .72rem; border: 1px solid var(--line); color: var(--sub) }
.chip.ok { color: var(--ok); border-color: color-mix(in oklab, var(--ok) 50%, transparent) }
.chip.w { color: var(--warn); border-color: color-mix(in oklab, var(--warn) 50%, transparent) }
.chip.e { color: var(--err); border-color: color-mix(in oklab, var(--err) 50%, transparent) }

.dock { justify-self: center; display: flex; gap: 10px; padding: 7px 12px; margin-bottom: 10px; border-radius: 8px;
  background: color-mix(in oklab, var(--s1) 70%, transparent); backdrop-filter: blur(14px) }
.dock span { width: 30px; height: 30px; border-radius: 6px; background: var(--s3); position: relative }
.dock span:nth-child(2) { background: color-mix(in oklab, var(--lead) 35%, var(--s3)) }
.dock span:nth-child(4) { background: color-mix(in oklab, var(--second) 35%, var(--s3)) }
.dock span.run::after { content: ""; position: absolute; bottom: -5px; left: 50%; width: 10px; height: 2px; margin-left: -5px; border-radius: 1px; background: var(--lead) }

.browser { border-radius: 6px; overflow: hidden; border: 1px solid var(--line); background: var(--bg) }
.tabs { display: flex; gap: 2px; padding: 6px 8px 0; background: var(--bg); overflow-x: auto }
.tab { padding: 7px 14px; font: 400 .78rem var(--ui); color: var(--muted); border-radius: 6px 6px 0 0; white-space: nowrap; display: flex; gap: 8px; align-items: center }
.tab .fav { width: 10px; height: 10px; border-radius: 2px; background: var(--muted) }
.tab.on { background: var(--s2); color: var(--text); box-shadow: inset 0 2px 0 var(--lead) }
.tab.on .fav { background: var(--lead) }
.tab .spin { width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--second); border-right-color: transparent }
.omni { display: flex; gap: 10px; align-items: center; padding: 7px 10px; background: var(--s2) }
.omni .url { flex: 1; min-width: 0; background: var(--s1); border-radius: 14px; padding: 5px 12px; font: 400 .8rem var(--ui); color: var(--sub); overflow: hidden; white-space: nowrap; text-overflow: ellipsis }
.omni .url b { color: var(--text); font-weight: 400 }
.omni .ic { width: 14px; height: 14px; border-radius: 3px; border: 2px solid var(--muted) }
.omni .ic.star { border-color: var(--second) }
.pagebody { padding: 16px 18px; font-size: .88rem; color: var(--sub); line-height: 1.5 }
.pagebody mark { background: color-mix(in oklab, var(--lead) 35%, transparent); color: var(--text) }

.sheet { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 20px }
.sw { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 8px }
.swc { border: 1px solid var(--line); border-radius: 4px; overflow: hidden; background: var(--s1) }
.swc .chipc { height: 40px }
.swc .meta { padding: 6px 8px; font: 400 .72rem var(--mono); display: grid; gap: 2px }
.swc .meta b { font-weight: 500; color: var(--text) }
.swc .meta span { color: var(--muted); font-variant-numeric: tabular-nums }
.ansi { display: grid; grid-template-columns: repeat(8, minmax(0,1fr)); gap: 4px; margin-top: 12px }
.ansi div { height: 26px; border-radius: 3px; font: 400 .62rem var(--mono); display: grid; place-items: center; color: var(--bg) }
.tablewrap { overflow-x: auto }
table { width: 100%; border-collapse: collapse; font: 400 .78rem var(--mono); font-variant-numeric: tabular-nums }
th, td { text-align: left; padding: 5px 6px; border-bottom: 1px solid var(--line) }
th { color: var(--muted); font-weight: 500; font-size: .7rem; text-transform: uppercase; letter-spacing: .08em }
td.r, th.r { text-align: right }
.pass { color: var(--ok) } .fail { color: var(--err) }
.note { font-size: .84rem; color: var(--sub); line-height: 1.55; border-left: 3px solid var(--second); padding: 4px 0 4px 12px; margin: 12px 0 0 }
.note b { color: var(--text); font-weight: 600 }

@media (max-width: 960px) {
  .stage { grid-template-columns: minmax(0,1fr) }
  .term-col, .set-col { grid-column: 1 }
  .sheet { grid-template-columns: minmax(0,1fr) }
  .desk { min-height: 0 }
}
@media (prefers-reduced-motion: no-preference) {
  .tab .spin { animation: sp 1s linear infinite }
  @keyframes sp { to { transform: rotate(360deg) } }
}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>λ palette tuner · <b>cyan rim</b> / <i>amber core</i></h1>
    <p class="lede">Every colour of the Liquid Lambda themes comes from the handful of inputs below. Move them, then press <b>Copy palette.toml</b> and paste the block into <code>palette.toml</code>; <code>uv run lambda build</code> renders every app from it. <code>uv run lambda preview --wallpaper your.png</code> puts your own wallpaper behind the desktop.</p>
  </header>

  <section class="controls" aria-label="Palette controls">
    <div class="ctl"><span class="lbl">Lead colour</span>
      <div class="seg" data-key="lead"><button data-v="cyan">cyan</button><button data-v="amber">amber</button></div></div>
    <div class="ctl"><span class="lbl">Grey tint</span>
      <div class="seg" data-key="tint"><button data-v="warm">warm</button><button data-v="neutral">neutral</button><button data-v="cool">cool</button></div></div>
    <div class="ctl"><label for="tint_strength">Tint strength <span id="tint_strengthV"></span></label><input id="tint_strength" type="range" min="0" max="100"></div>
    <div class="ctl"><label for="second_loudness">Second colour loudness <span id="second_loudnessV"></span></label><input id="second_loudness" type="range" min="20" max="100"></div>
    <div class="ctl"><label for="cyan_hue">Cyan hue <span id="cyan_hueV"></span></label><input id="cyan_hue" type="range" min="180" max="235"></div>
    <div class="ctl"><label for="amber_hue">Amber hue <span id="amber_hueV"></span></label><input id="amber_hue" type="range" min="35" max="85"></div>
    <div class="ctl"><label for="lead_chroma">Lead saturation <span id="lead_chromaV"></span></label><input id="lead_chroma" type="range" min="40" max="100"></div>
    <div class="ctl actions"><button class="btn primary" id="copy">Copy palette.toml</button><button class="btn" id="reset">Reset</button><span class="toast" id="toast" role="status"></span></div>
  </section>

  <section class="desk" aria-label="COSMIC desktop mock">
    <div class="panel">
      <div class="ws"><span class="on">1</span><span>2</span><span>3</span></div>
      <span>WezTerm</span><span class="grow"></span>
      <span><span class="dot"></span>2 updates</span><span>Sun 25 Oct</span><span>23:41</span>
    </div>
    <div class="stage">
      <div class="win active term-col">
        <div class="bar">user@pop-os: ~/repos/liquid-lambda-theme<span class="x"></span></div>
        <div class="term" id="term"></div>
      </div>
      <div class="win set-col">
        <div class="bar">Settings<span class="x"></span></div>
        <div class="set">
          <div class="side"><div>Network</div><div>Bluetooth</div><div class="sel">Appearance</div><div>Displays</div><div>Sound</div><div>Power</div></div>
          <div class="main">
            <h3>Appearance</h3>
            <div class="row">Frosted glass <span class="tog on"></span></div>
            <div class="row">Square corners <span class="tog"></span></div>
            <div style="display:grid;gap:8px">Window opacity<div class="slide"></div></div>
            <div class="field">Lambda<i></i></div>
            <div class="banner"><b>Restart needed.</b> Log out to apply the cursor theme.</div>
            <div class="chips"><span class="chip ok">synced</span><span class="chip w">2 updates</span><span class="chip e">1 failed</span></div>
            <div class="btns"><button class="mb p" tabindex="-1">Apply</button><button class="mb s" tabindex="-1">Export</button><button class="mb d" tabindex="-1">Reset</button></div>
            <div>Theme files live in <span class="ln">~/.config/cosmic</span></div>
          </div>
        </div>
      </div>
    </div>
    <div class="dock"><span></span><span class="run"></span><span></span><span class="run"></span><span></span><span></span></div>
  </section>

  <section class="browser" aria-label="Chromium theme mock">
    <div class="tabs">
      <div class="tab on"><span class="fav"></span>liquid-lambda-theme</div>
      <div class="tab"><span class="spin"></span>Loading…</div>
      <div class="tab"><span class="fav"></span>Home Assistant</div>
      <div class="tab"><span class="fav"></span>Linear · My issues</div>
    </div>
    <div class="omni"><span class="ic"></span><div class="url">github.com/<b>Liquidmasl/liquid-lambda-theme</b></div><span class="ic star"></span></div>
    <div class="pagebody">Search hits show up as <mark>highlighted text</mark>, links as <span class="ln">underlined cyan</span>, and the loading spinner uses the second colour.</div>
  </section>

  <section class="sheet" aria-label="Palette and contrast">
    <div>
      <h2>Palette</h2>
      <div class="sw" id="sw"></div>
      <div class="ansi" id="ansi"></div>
      <p class="note" id="note"></p>
    </div>
    <div>
      <h2>Contrast gates (lambda check)</h2>
      <div class="tablewrap"><table><thead><tr><th>Role</th><th>On</th><th class="r">Ratio</th><th class="r">Need</th></tr></thead><tbody id="ctab"></tbody></table></div>
    </div>
  </section>
</div>

<script>
{% include "tuner/engine.js" %}
</script>
<script>
(() => {
  const DEF = {{ settings | tojson }};
  const GATES = {{ contrast_gates | tojson }};
  const KNOBS = ["tint_strength", "second_loudness", "cyan_hue", "amber_hue", "lead_chroma"];
  const STORE = "lambda-tuner";
  let S = { ...DEF };
  // a stored tuning only applies while palette.toml still has the defaults it started from
  try {
    const saved = JSON.parse(localStorage.getItem(STORE) || "null");
    if (saved && JSON.stringify(saved.base) === JSON.stringify(DEF)) Object.assign(S, saved.s);
  } catch (e) {}

  const css = document.documentElement.style;
  const VARS = { bg: "bg", surface1: "s1", surface2: "s2", surface3: "s3", line: "line", dim: "dim", muted: "muted",
    sub: "sub", text: "text", lead: "lead", lead_ink: "lead-ink", second: "second", second_ink: "second-ink",
    cyan: "cyan", amber: "amber", ok: "ok", warn: "warn", err: "err", link: "link", hint: "hint" };
  function apply(P) {
    for (const [role, v] of Object.entries(VARS)) css.setProperty("--" + v, P.roles[role]);
    P.ansi.forEach((c, i) => css.setProperty("--a" + i, c));
  }

  const T = (cls, t) => `<span class="${cls}">${t}</span>`;
  document.getElementById("term").innerHTML = [
    T("f6 b","~/repos/liquid-lambda-theme") + " on " + T("f5 b","⎇ main") + " " + T("f1 b","[!?]") + " via " + T("f3 b","py v3.12"),
    T("f2 b","❯") + " lsd -l",
    T("f8","drwxrwxr-x user ") + T("f8","4.0 KB ") + T("f7","Oct 25 ") + T("f4 b","liquid_lambda/"),
    T("f8","drwxrwxr-x user ") + T("f8","4.0 KB ") + T("f7","Oct 25 ") + T("f4 b","templates/"),
    T("f8",".rwxrwxr-x user ") + T("f8","2.1 KB ") + T("f7","Oct 25 ") + T("f2 b","switch.sh*"),
    T("f8",".rw-rw-r-- user ") + T("f3","23 KB  ") + T("f7","Oct 25 ") + "palette.toml",
    T("f8","lrwxrwxrwx user ") + T("f8","  33 B ") + T("f7","Oct 25 ") + T("f6","wezterm.lua") + T("f8"," ⇒ ~/.config/wezterm/wezterm.lua"),
    T("f2 b","❯") + " git status -s",
    T("f2"," M") + " palette.toml      " + T("f1","??") + " templates/btop/",
    T("f1 b","❯") + " cargo buil",
    T("f1 b","error") + T("b",": no such command: `buil`") + "   " + T("f3","warning") + ": did you mean `build`?",
    "",
    T("pz-h","● Palette plan"),
    "  " + T("pz-b","•") + " one source in " + T("pz-p","palette.toml") + ", rendered into " + T("pz-n","14") + " targets",
    "  " + T("pz-b","•") + " the terminal gets 16 ANSI slots, prismantis gets " + T("pz-c","`*Color`") + " hex",
    "  " + T("pz-b","•") + " see " + T("pz-l","github.com/Liquidmasl/liquid-lambda-theme"),
    "  " + T("pz-r","┌────────────┬──────────┐"),
    "  " + T("pz-r","│") + T("pz-th"," target     ") + T("pz-r","│") + T("pz-th"," source   ") + T("pz-r","│"),
    "  " + T("pz-r","├────────────┼──────────┤"),
    "  " + T("pz-r","│") + " starship   " + T("pz-r","│") + " ANSI     " + T("pz-r","│"),
    "  " + T("pz-r","│") + " prismantis " + T("pz-r","│") + T("pz-s"," hex      ") + T("pz-r","│"),
    "  " + T("pz-r","└────────────┴──────────┘"),
    "",
    T("f2 b","❯") + " " + T("f8","▌"),
  ].join("\n") +
  `<div class="sl">${T("f6","~/repos/liquid-lambda-theme")}  ${T("f2 b","main ✓")}  ${T("f3","Opus 5.5")}  ${T("f4 b","ctx 42%")}  ${T("f8 dimt","rate 18%")}  ${T("f5","#51 palette")}</div>`;

  function sheet(P) {
    const R = P.roles;
    const roles = [["bg","window bg"],["surface1","surface"],["surface3","raised"],["line","lines"],["muted","muted"],["text","text"],
      ["lead","lead · " + S.lead],["second","second"],["ok","success"],["warn","warning"],["err","error"]];
    document.getElementById("sw").innerHTML = roles.map(([k, n]) =>
      `<div class="swc"><div class="chipc" style="background:${R[k]}"></div><div class="meta"><b>${n}</b><span>${R[k]}</span></div></div>`).join("");
    const names = ["blk","red","grn","yel","blu","mag","cyn","wht"];
    document.getElementById("ansi").innerHTML = P.ansi.map((c, i) =>
      `<div style="background:${c}" title="ANSI ${i}">${i < 8 ? names[i] : "br" + (i - 8)}</div>`).join("");
    document.getElementById("ctab").innerHTML = GATES.map(([fg, bg, need]) => {
      const r = LambdaEngine.contrast(R[fg], R[bg]);
      return `<tr><td>${fg}</td><td>${bg}</td><td class="r ${r >= need ? "pass" : "fail"}">${r.toFixed(2)}:1</td><td class="r">${need}</td></tr>`;
    }).join("");
    document.getElementById("note").innerHTML = S.lead === "cyan"
      ? "<b>Cyan leads:</b> it carries focus, selection and buttons; amber only shows up when something wants attention (warnings, the update dot, bullets, the spinner). Turn down <b>second colour loudness</b> if amber still jumps out."
      : "<b>Amber leads:</b> it carries the UI and cyan becomes the edge colour (links, paths). Warnings move to yellow so they stay apart from the accent, but yellow and amber sit close together.";
  }

  function sync() {
    document.querySelectorAll(".seg").forEach(g => g.querySelectorAll("button").forEach(b =>
      b.setAttribute("aria-pressed", String(S[g.dataset.key] === b.dataset.v))));
    KNOBS.forEach(k => {
      document.getElementById(k).value = S[k];
      document.getElementById(k + "V").textContent = k.endsWith("hue") ? S[k] + "°" : S[k] + "%";
    });
    document.getElementById("tint_strength").disabled = S.tint === "neutral";
    const P = LambdaEngine.buildPalette(S);
    apply(P); sheet(P);
    try { localStorage.setItem(STORE, JSON.stringify({ base: DEF, s: S })) } catch (e) {}
  }

  document.querySelectorAll(".seg").forEach(g => g.addEventListener("click", e => {
    const b = e.target.closest("button"); if (!b) return; S[g.dataset.key] = b.dataset.v; sync();
  }));
  KNOBS.forEach(k => document.getElementById(k).addEventListener("input", e => { S[k] = +e.target.value; sync() }));
  document.getElementById("reset").addEventListener("click", () => { S = { ...DEF }; sync() });

  function toml() {
    const q = v => typeof v === "string" ? `"${v}"` : String(v);
    const keys = ["lead", "tint", ...KNOBS];
    let out = "[palette]\n" + keys.map(k => `${k} = ${q(S[k])}`).join("\n") + "\n";
    const pins = Object.entries(S.pin || {});
    if (pins.length) out += "\n[pin]\n" + pins.map(([k, v]) => `${k} = "${v}"`).join("\n") + "\n";
    return out;
  }
  const toast = t => { const el = document.getElementById("toast"); el.textContent = t; setTimeout(() => el.textContent = "", 2500) };
  document.getElementById("copy").addEventListener("click", () => {
    const text = toml();
    navigator.clipboard.writeText(text).then(() => toast("Copied. Paste it into palette.toml."),
      () => { console.log(text); toast("Clipboard blocked; the block is in the console.") });
  });

  sync();
})();
</script>
</body>
</html>
