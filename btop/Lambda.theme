# Liquid Lambda theme for btop.
# Generated by `uv run lambda build` from templates/btop/Lambda.theme.j2. Do not edit.
# `lambda apply --only btop` links it into ~/.config/btop/themes/ and selects it.

# Main background, empty for terminal default (needed for a transparent terminal)
theme[main_bg]="#140c0b"
theme[main_fg]="#bcb6b5"
theme[title]="#00dffe"
# keyboard shortcuts
theme[hi_fg]="#d19555"
theme[selected_bg]="#00dffe"
theme[selected_fg]="#160d0c"
theme[inactive_fg]="#473d3c"
theme[graph_text]="#928a89"
theme[meter_bg]="#261d1b"
theme[proc_misc]="#e4e0df"

theme[cpu_box]="#473d3c"
theme[mem_box]="#473d3c"
theme[net_box]="#473d3c"
theme[proc_box]="#473d3c"
theme[div_line]="#332927"

# Meters and graphs run cool to hot: cyan rim -> amber core -> error red
theme[temp_start]="#00dffe"
theme[temp_mid]="#d19555"
theme[temp_end]="#ef6661"
theme[cpu_start]="#00dffe"
theme[cpu_mid]="#d19555"
theme[cpu_end]="#ef6661"
theme[free_start]="#00dffe"
theme[free_mid]="#d19555"
theme[free_end]="#ef6661"
theme[download_start]="#00dffe"
theme[download_mid]="#d19555"
theme[download_end]="#ef6661"
theme[upload_start]="#00dffe"
theme[upload_mid]="#d19555"
theme[upload_end]="#ef6661"

theme[cached_start]="#79a7e2"
theme[cached_mid]="#79a7e2"
theme[cached_end]="#79a7e2"

theme[available_start]="#88ca95"
theme[available_mid]="#88ca95"
theme[available_end]="#88ca95"

theme[used_start]="#d19555"
theme[used_mid]="#d19555"
theme[used_end]="#ef6661"

theme[process_start]="#00dffe"
theme[process_mid]="#d19555"
theme[process_end]="#ef6661"
